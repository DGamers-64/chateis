{
  "name": "chateis",
  "version": "0.0.1",
  "description": "Servidor y cliente de chat especializado para ejecutar en local",
  "keywords": [
    "chat",
    "nodejs"
  ],
  "homepage": "https://github.com/DGamers-64/chateis#readme",
  "bugs": {
    "url": "https://github.com/DGamers-64/chateis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DGamers-64/chateis.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "xLune64",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev:server": "node --watch --env-file=.env index.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node --watch --env-file=.env index.js",
    "install": "node --env-file=.env instalacion.js"
  },
  "dependencies": {
    "axios": "1.12.2",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-mysql-session": "3.0.3",
    "express-session": "1.18.2",
    "mysql2": "3.15.1",
    "vue-router": "4.5.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "concurrently": "9.2.1",
    "vite": "7.1.7",
    "vue": "3.5.22"
  }
}
